#!/usr/bin/env ruby
# frozen_string_literal: true

# Development entrypoint: loads lib/ and the sibling protocol checkout. Installed gems use
# exe/pinecall.
root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
sibling = File.expand_path("../protocol/ruby/lib", root)
$LOAD_PATH.unshift(sibling) if File.directory?(sibling)

require "pinecall"

exit Pinecall::CLI.run(ARGV)
