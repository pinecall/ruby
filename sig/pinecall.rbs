# The public surface, as types. Ruby's answer to the `.d.ts` the TypeScript package ships.
#
# The state a class declares is generated at load, so it cannot be typed here — that is what a
# tenant's own `sig/` is for, one line per `state`. Everything the framework itself offers is.

module Pinecall
  VERSION: String

  type state = Hash[Symbol, untyped]
  type spec = Hash[Symbol, untyped]
  type line = { channel: String, ?from: String? }

  class Error < StandardError
  end

  class Refused < Error
    attr_reader refusal: Hash[Symbol, untyped]
    def code: () -> String
  end

  class UnauthoredWrite < Error
  end

  class DeclarationRefused < Error
  end

  class ToolFailed < Error
  end

  class NotConnected < Error
  end

  class Reading
    def initialize: (state, ?Array[String]) -> void
    def to_h: () -> state
    def []: (String | Symbol) -> untyped
    def key?: (String | Symbol) -> bool
    def fetch: (String | Symbol, *untyped) -> untyped
    def remembers?: (String) -> bool
  end

  type block_spec = { name: String, region: String }

  class Block
    attr_reader name: String
    attr_reader region: String
    attr_reader text: String
  end

  class Blocks
    attr_reader blocks: Array[Block]
    attr_reader history: String
    def []: (String | Symbol) -> String?
    def static: () -> Array[Block]
    def dynamic: () -> Array[Block]
    def instructions: () -> String
  end

  class View
    def self.beside: (String, String) -> String
    def self.file: (String) -> View
    def self.inline: (String, ?String) -> View
    attr_reader path: String
    def render: (Reading) -> String
    def tidy: (String) -> String
  end

  class Agent
    def self.written: () -> Array[Class]

    # config, declared on the class
    def self.phone: (?String) -> untyped
    def self.whatsapp: (?String) -> untyped
    def self.web: (?bool) -> untyped
    def self.voice: (?String | Hash[Symbol, untyped]) -> untyped
    def self.llm: (?String | Hash[Symbol, untyped]) -> untyped
    def self.language: (?String | Symbol) -> untyped
    def self.says: (?Hash[Symbol | String, String]) -> untyped
    def self.hears: (?Array[String]) -> untyped
    def self.knowledge: (?String) -> String?
    def self.knowledge_file: () -> String?
    def self.knowledge_text: () -> String?
    def self.docs: (?String | Symbol, **untyped) -> Hash[Symbol, untyped]?
    def self.memory: (**untyped) -> Hash[Symbol, untyped]?
    def self.doc: (?String) -> String?
    def self.slug: (?String) -> String
    def self.accepts: (String | Symbol, from: Array[String | Symbol]) -> untyped
    def self.routes: () -> Array[Hash[Symbol, untyped]]
    def self.wire_config: (?tools: Array[spec]?) -> Hash[Symbol, untyped]

    # the state and the verbs
    def self.state: (Symbol, ?untyped, ?visibility: Symbol?) ?{ () -> untyped } -> Symbol
    def self.stage: (*Symbol) -> Array[Symbol]
    def self.stages: () -> Array[Symbol]?
    def self.declared_state: () -> Hash[Symbol, untyped]
    def self.derived_state: () -> Hash[Symbol, untyped]
    def self.state_names: () -> Array[Symbol]
    def self.tool: (**untyped) -> untyped
    def self.declared_tools: () -> Hash[Symbol, untyped]
    def self.tool_named: (String | Symbol) -> untyped
    def self.view: (?String?, ?template: String?) -> View?
    def self.beside_this_file: (String) -> String
    def self.source_file: () -> String?

    def doc: () -> String?
    def tools: () -> Array[spec]
    def visible_tools: () -> Array[spec]
    def run_tool: (String | Symbol, ?Hash[Symbol, untyped]) -> untyped
    def snapshot: () -> state
    def restore: (state) -> Agent
    def start_in: (state) -> Agent
    def diff: (state, ?state) -> Array[Hash[Symbol, untyped]]
    def collapse: (String) -> untyped
    def changes: () -> Array[untyped]
    def on_change: () { (untyped) -> void } -> ^() -> void
    def on_log: () { (untyped) -> void } -> ^() -> void
    def on_heard: () { (String, Hash[Symbol, untyped], Hash[Symbol, untyped]) -> void } -> ^() -> void
    def seal: () -> Agent
    def sealed?: () -> bool
    def call: () -> CallWorld
    def call?: () -> bool
    def say: (String, **untyped) -> bool
    def reply: (String, **untyped) -> bool
    def log: (String | Symbol, ?untyped) -> untyped
    def logged: () -> Array[untyped]
    def last: (String) -> state?
    def on_call: (CallWorld) -> void
    def on_end: (CallWorld) -> void
    def on_event: (String, Hash[Symbol, untyped], Hash[Symbol, untyped]) -> void
    def on_memory: (Array[untyped], CallWorld) -> void
    def run_hook: (Symbol, *untyped) -> untyped
    def serving: (CallWorld?) -> Agent
    def reads_last_from: (^(String) -> state?) -> Agent
    def notify_heard: (String, Hash[Symbol, untyped], Hash[Symbol, untyped]) -> void

    module Author
      KEY: Symbol
      def self?.current: () -> String?
      def self?.with: [T] (String) { () -> T } -> T
    end

    module Doc
      def self.for_class: (Class) -> String?
      def self.for_method: (Class, Symbol) -> String?
      def self.above: (String, Integer) -> String?
      def self.forget: () -> untyped
    end
  end

  class CallWorld
    attr_reader id: String
    attr_reader contact: String?
    attr_reader from: String?
    attr_reader channel: String?
    attr_accessor cause: Hash[Symbol, untyped]?
    def today: () -> String
    def numbered: () -> Integer
    def say: (String, **untyped) -> bool
    def reply: (String, **untyped) -> bool
    def send_to: (String, untyped, ?to: Array[String]?) -> untyped
    def participant: (String) -> untyped
    def invite: (String, ?kind: String?) -> untyped
    def log: (String | Symbol, ?Hash[Symbol, untyped]) -> untyped
    def hangup: (?String?) -> untyped
    def take: (String, Hash[Symbol, untyped], Float) -> untyped
    def participants: () -> Array[untyped]
    def caller_seat: () -> untyped
    def last_turn: () -> untyped
  end

  class Client
    attr_reader url: String
    attr_reader api_key: String
    def initialize: (?url: String?, ?api_key: String?, ?ping_every: Numeric, ?backoff: Hash[Symbol, Numeric]) -> void
    def sdk: () -> String
    def agent: (String, **untyped) -> Client::Agent
    def agents: () -> Hash[String, Client::Agent]
    def connect: () -> Client
    def close: () -> untyped
    def connected?: () -> bool
    def on: (String) { (Hash[Symbol, untyped], Client::Call?) -> void } -> ^() -> void
    def on_any: () { (untyped, Client::Call?) -> void } -> ^() -> void
    def on_errors: () { (StandardError) -> void } -> ^() -> void
    def observe: (Hash[Symbol, String], **untyped) { (untyped) -> void } -> void
    def history: (Hash[Symbol, String], **untyped) -> untyped
    def knowledge: () -> Client::Knowledge
    def memory_of: (String) -> Client::ContactMemory
    def provider_keys: () -> Client::ProviderKeys
    def send_command: (type: String, agent: String, call: String?, data: Hash[Symbol, untyped], ?id: String?) -> untyped
    def seen: (untyped, Client::Call?) -> void
    def on_error: (StandardError) -> void

    class Agent
      attr_reader slug: String
      attr_reader calls: CallBook
      attr_reader config: Hash[Symbol, untyped]
      attr_reader app: String?
      def on: (String) { (Hash[Symbol, untyped], Client::Call?) -> void } -> ^() -> void
      def on_any: () { (untyped, Client::Call?) -> void } -> ^() -> void
      def declare: (Array[Hash[Symbol, untyped]]) -> void
      def configure: (?Hash[Symbol, untyped]) -> Hash[Symbol, untyped]
      def open: () -> Agent
      def take: (untyped) -> void
      def command: (String, String?, Hash[Symbol, untyped]) -> untyped
      def ping: () -> untyped
      def on_error: (StandardError) -> void
    end

    class Call
      attr_reader id: String
      attr_reader today: String
      attr_accessor status: String
      attr_accessor channel: String?
      attr_accessor from: String?
      attr_accessor to: String?
      attr_accessor contact: Hash[Symbol, untyped]?
      attr_accessor state: Hash[Symbol, untyped]
      def say: (String, **untyped) -> untyped
      def reply: (String, **untyped) -> untyped
      def set_prompt: (String | Symbol, String) -> untyped
      def set_tools: (Array[Hash[Symbol, untyped]]) -> untyped
      def set_state: (Hash[Symbol, untyped], ?Array[Symbol | String]?) -> untyped
      def tool_result: (Hash[Symbol, untyped]) -> untyped
      def event: (String, Hash[Symbol, untyped]) -> untyped
      def hangup: (?String?) -> untyped
      def log: (String | Symbol, ?Hash[Symbol, untyped]) -> untyped
      def command: (String, Hash[Symbol, untyped]) -> untyped
      def take: (untyped) -> void
      def on: (String) { (Hash[Symbol, untyped], Call) -> void } -> ^() -> void
      def on_any: () { (untyped, Call) -> void } -> ^() -> void
    end

    class CallBook
      def live: () -> Array[Call]
      def of: (String, Float) -> Call
      def forget: (Call) -> untyped
    end

    class Listeners
      def on: (String | Symbol) { (untyped, untyped) -> void } -> ^() -> void
      def on_any: () { (untyped, untyped) -> void } -> ^() -> void
      def emit: (untyped, untyped) -> void
    end

    class Knowledge
      def initialize: (url: String, api_key: String) -> void
      def push: (String, Array[{ path: String, text: String }]) -> Hash[Symbol, untyped]
      def bases: () -> Array[Hash[Symbol, untyped]]
      def drop: (String) -> nil
    end

    class ContactMemory
      attr_reader contact: String
      def initialize: (String, url: String, api_key: String) -> void
      def history: () -> Array[Hash[Symbol, untyped]]
      def forget: () -> Integer
    end

    class ProviderKeys
      def initialize: (url: String, api_key: String) -> void
      def add: (String, String) -> nil
      def remove: (String) -> nil
      def vendors: () -> Array[String]
    end

    module Rest
      def self?.get: (String, api_key: String) -> Hash[Symbol, untyped]?
      def self?.put: (String, untyped, api_key: String) -> Hash[Symbol, untyped]?
      def self?.delete: (String, api_key: String) -> Hash[Symbol, untyped]?
    end
  end

  module Prompt
    FRAMEWORK: Array[block_spec]
    def self?.render: (Agent, ?resumed: bool, ?remembered: Array[String], ?line: line?) -> Blocks
    def self?.identity: (Agent) -> String
    def self?.knowledge: (Agent) -> String
    def self?.tools: (Agent) -> String
    def self?.history: (Agent) -> String
    def self?.collapsed: (Integer) -> String
    def self?.show: (Agent, **untyped) -> String
    def self?.header_for: (Symbol | String, ?String?) -> String
  end

  module Bridge
    def self?.mount: (Class, client: untyped, ?slug: String?, ?last: untyped, ?opening: untyped,
                      ?takes_unclaimed: bool) -> Mounted

    class Mounted
      attr_reader slug: String
      attr_reader agent: Client::Agent
      attr_reader options: Hash[Symbol, untyped]
      def serving: (String) -> Agent?
    end
  end

  module Lang
    DEFAULT: String
    def self?.words_for: (Class) -> Hash[Symbol, String]
    def self?.languages: () -> Array[String]
  end

  module UI
    FILES: String
    def self?.run: (Array[String], ?out: IO, ?err: IO, ?files: String, ?open: (^(String) -> void)?,
                    ?env: Hash[String, String]) -> Integer

    class Server
      LOOPBACK: String
      attr_reader url: String
      def self.open: (door: untyped, files: String) -> Server
      def listen: () -> Server
      def at: (String) -> String
      def close: () -> nil
    end

    module Browser
      def self?.headless: (?env: untyped, ?platform: Symbol) -> String?
      def self?.open: (String, ?platform: Symbol) -> nil
      def self?.this_platform: () -> Symbol
    end
  end

  module CLI
    PLANNED: Hash[String, String]
    def self?.run: (Array[String], ?out: IO, ?err: IO, ?input: IO) -> Integer
    def self?.door: (IO) -> Client?

    module Knowledge
      DEFAULT_DIR: String
      def self?.run: (Array[String], out: IO, err: IO) -> Integer
    end

    module Memory
      def self?.run: (Array[String], input: IO, out: IO, err: IO) -> Integer
    end

    module Keys
      def self?.run: (Array[String], input: IO, out: IO, err: IO) -> Integer
    end

    module Env
      LOCAL: String
      def self?.home: () -> String
      def self?.pointed: () -> untyped
    end
  end

  def self.mount: (Class, client: untyped, **untyped) -> Bridge::Mounted
  def self.render: (Agent, **untyped) -> Blocks
  def self.show_prompt: (Agent, **untyped) -> String
end
